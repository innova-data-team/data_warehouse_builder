# ============================================================
# Data Warehouse Builder - example environment file
# Copy to ".env" and adjust for your environment.
# ============================================================

# ---- App ----------------------------------------------------
APP_NAME=DataWarehouseBuilder
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---- Storage (filesystem) -----------------------------------
STORAGE_ROOT=./storage
RAW_DIR=./storage/raw
CACHE_DIR=./storage/cache
EXPORTS_DIR=./storage/exports
REPORTS_DIR=./storage/reports
SQL_OUTPUT_DIR=./sql/generated

# ---- Storage backend ------------------------------------------
# file = parquet + JSON under storage/ (no MySQL required)
# mysql = full MySQL pipeline
STORAGE_BACKEND=file

# ---- MySQL connection (only when STORAGE_BACKEND=mysql) -----
# pymysql is recommended on Windows; mysqlconnector also works
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DRIVER=pymysql
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# ---- Logical database names ---------------------------------
MYSQL_DB_METADATA=dw_metadata
MYSQL_DB_BRONZE=dw_bronze
MYSQL_DB_SILVER=dw_silver
MYSQL_DB_GOLD=dw_gold

# ---- Pipeline tuning ----------------------------------------
MAX_UPLOAD_MB=512
CSV_SAMPLE_BYTES=131072
EXCEL_SHEET_MAX_ROWS=2000000
RELATIONSHIP_MIN_CONFIDENCE=0.55
RELATIONSHIP_VALUE_OVERLAP_THRESHOLD=0.60
PROFILER_SAMPLE_ROWS=100000
ENABLE_ARABIC_NORMALIZATION=true
TASHKEEL_REMOVAL=true
NORMALIZE_TAA_MARBUTA=false
